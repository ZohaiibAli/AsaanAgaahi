# MongoDB (Atlas or local) — all persistence (users, pairing, progress, voice notes, alerts)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=practice_mode

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS — Expo dev server origin
FRONTEND_ORIGIN=http://localhost:8081

# LLM (backend-only — never expose a key to the frontend)
LLM_PROVIDER=gemini          # gemini | anthropic | openai
MOCK_LLM=false               # true forces the deterministic keyword fallback (no API calls)
LLM_TIMEOUT_SECONDS=8
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OTP — no SMS gateway is wired up for this hackathon build.
# "mock" generates a real code, stores it hashed, and returns/logs it instead of texting it.
OTP_PROVIDER=mock
OTP_EXPIRE_SECONDS=300

# server
HOST=0.0.0.0
PORT=8000
