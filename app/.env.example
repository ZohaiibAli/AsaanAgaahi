# Point these at the backend. "localhost" only works in a simulator/emulator or web —
# on a real phone in Expo Go, replace with your laptop's LAN IP (e.g. 192.168.1.5),
# since the phone and laptop must be on the same WiFi network.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000
